# ---- Firebase (the platform's own project) — Project settings → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account JSON (Project settings → Service accounts → Generate new private key), whole file on ONE line
FIREBASE_SERVICE_ACCOUNT=

# ---- TikTok (developers.tiktok.com → your app)
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# inbox = sends to the user's TikTok drafts (works before audit) · direct = posts to profile (after audit)
TIKTOK_POST_MODE=inbox

# ---- Scheduler: any long random string; the cron sends it as "Authorization: Bearer …"
CRON_SECRET=
