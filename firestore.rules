rules_version = '2';
// Paste into Firebase console → Firestore → Rules (merge with existing rules
// for presets/ and config/ used by the Opaque apps).
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user owns exactly their own tree — including the TikTok tokens
    // stored on their user doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /creatives/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
