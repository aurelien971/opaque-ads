rules_version = '2';
// Beta rules — signed-in users write, anyone can read (TikTok fetches the file).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
